# NAME: O-KAM BW4-G (T23ZN, OS02N10, AIC8800M40B SDIO, Battery)
# ADAPTED from besder_w9q + wansview_a1 (battery T23ZN)
# FRAG: soc-xburst1 core
#
# SoC: Ingenic T23ZN, XBurst1 MIPS32 R1, 64MB RAM (46M+18M split)
# Sensor: OmniVision OS02N10, 2MP, I2C 0x3c
# WiFi: AIC8800M40B, SDIO
# Flash: 16MB NOR SPI
# UART: ttyS1 (console), ttyS0 (MCU 9600 baud)
# Battery: PUYA MCU on ttyS0, PIR wake

BR2_INGENIC_SOC_MODEL="t23zn"
BR2_ISP_CONFIG_HZ=200000000
BR2_PACKAGE_THINGINO_KOPT_MMC0=y
BR2_PACKAGE_THINGINO_KOPT_MMC0_PB_4BIT=y
BR2_PACKAGE_WIFI=y
BR2_PACKAGE_WIFI_AIC8800=y
BR2_PACKAGE_WIFI_AIC8800_SDIO=y
BR2_PACKAGE_WIFI_AIC8800_SDIO_8800=y
BR2_SENSOR_1_NAME="os02n10s0"
BR2_SENSOR_2_NAME="os02n10s1"
BR2_THINGINO_AUDIO=y
BR2_THINGINO_BUTTON=y
BR2_THINGINO_IMAGE_SENSOR_QTY=2
BR2_THINGINO_LED_R_GPIO=54
BR2_THINGINO_PWM_ENABLE=y
BR2_THINGINO_SDCARD=y
BR2_THINGINO_DEV_BATTERY=y
BR2_THINGINO_RMEM_MB=18
FLASH_SIZE_MB=16
