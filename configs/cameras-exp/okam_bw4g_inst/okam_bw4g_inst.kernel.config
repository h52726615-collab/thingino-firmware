# okam bw4g installer kernel fragment
# hardcoded cmdline (stock bootloader args are fixed; OTA CMDL section is ignored)
CONFIG_CMDLINE_BOOL=y
CONFIG_CMDLINE_OVERRIDE=y
CONFIG_CMDLINE="console=ttyS1,115200n8 mem=46M@0x0 rmem=18M@0x2E00000 root=/dev/ram0 rw rdinit=/linuxrc mtdparts=jz_sfc:256K(boot),640K(tag),2048K(kernel),6144K(rootfs),8192K(rest),16M@0(all) lpj=4493312"

# embedded initramfs
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_RD_LZMA=y
CONFIG_RD_XZ=y
CONFIG_RD_LZ4=y

# mount stock rootfs for fallback / wifi borrow
CONFIG_JFFS2_FS=y
CONFIG_JFFS2_SUMMARY=y
CONFIG_JFFS2_FS_XATTR=y
CONFIG_JFFS2_COMPRESSION_OPTIONS=y

# devices
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_MTD_BLOCK=y

# wireless extensions for vendor drivers (stock aic8800 module)
CONFIG_WIRELESS_EXT=y
CONFIG_WEXT_CORE=y
CONFIG_WEXT_PROC=y
CONFIG_WEXT_PRIV=y
CONFIG_WEXT_SPY=y
